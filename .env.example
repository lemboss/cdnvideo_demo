APP_NAME=City Geo Service
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
DOCS_ENABLED=true
DOCS_ENABLED_IN_PRODUCTION=false
OPENAPI_ENABLED=true
LOG_LEVEL=INFO

API_KEY=replace-with-local-api-key
YANDEX_GEOCODER_API_KEY=replace-with-yandex-geocoder-api-key

CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576

DATABASE_URL=sqlite+aiosqlite:///./data/cities.db
AUTO_CREATE_SCHEMA=false

REDIS_URL=redis://redis:6379/0
REDIS_TIMEOUT_SECONDS=1.0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_EXEMPT_PATHS=/health

YANDEX_GEOCODER_URL=https://geocode-maps.yandex.ru/v1
HTTP_TIMEOUT_SECONDS=3.0
